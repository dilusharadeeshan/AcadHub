NODE_ENV=development
PORT=5000
# Transactions require Atlas or a replica set (compose.yaml provides one locally).
MONGODB_URI=mongodb://127.0.0.1:27017/acadhub?replicaSet=rs0&directConnection=true
# Generate a unique random value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
STORAGE_DRIVER=local
UPLOAD_DIR=./var/uploads
MAX_FILE_MB=10
# Production: STORAGE_DRIVER=s3 and a private bucket with no public ACLs.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
# Use workload credentials where possible. Otherwise set these in your secret manager.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Production requires a reachable private ClamAV daemon (never expose port 3310 publicly).
CLAMAV_HOST=
CLAMAV_PORT=3310
# Initial administrator. Set for seed, then remove the password from the runtime environment.
ADMIN_EMAIL=
ADMIN_NAME=AcadHub Administrator
ADMIN_PASSWORD=
# Development-only sample data. Choose a password; never enable in production.
SEED_DEMO=false
DEMO_PASSWORD=
